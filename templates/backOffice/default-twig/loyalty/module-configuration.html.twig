{% set domain = 'loyalty' %}

<div class="alert alert-info">
    {{ 'You can define here the amount credited to the loyalty account of your customers, according to the cart amount. Cart amount is the cart total, excluding shipping costs.'|trans({}, domain) }}
</div>

<form method="post" action="{{ path('loyalty_update') }}" id="loyalty-update-form">
    <input type="hidden" name="_token" value="{{ assignToken() }}">

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header">{{ 'Use multiple slices'|trans({}, domain) }}</div>
                <div class="card-body">
                    <p class="text-muted">{{ 'In this mode, you can define several slices, with a specific amount for each slice.'|trans({}, domain) }}</p>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="loyalty_mode" id="loyalty_mode_multiple" value="multiple" {{ mode == 'multiple' ? 'checked' }}>
                        <label class="form-check-label" for="loyalty_mode_multiple">{{ 'Use this mode'|trans({}, domain) }}</label>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'From cart amount'|trans({}, domain) }}</th>
                                    <th>{{ 'To cart amount'|trans({}, domain) }}</th>
                                    <th>{{ 'Amount added to loyalty account'|trans({}, domain) }}</th>
                                    <th class="text-end">{{ 'Action'|trans({}, domain) }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for slice in slices %}
                                <tr>
                                    {% for field in ['min', 'max', 'amount'] %}
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="text" inputmode="decimal" class="form-control" name="loyalty_{{ field }}[{{ slice.id }}]" value="{{ attribute(slice, field) }}">
                                                <span class="input-group-text">{{ currency_symbol }}</span>
                                            </div>
                                        </td>
                                    {% endfor %}
                                    <td class="text-end">
                                        <button type="submit" form="loyalty-delete-{{ slice.id }}" class="btn btn-sm btn-outline-danger" title="{{ 'Delete this slice'|trans({}, domain) }}">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4">
                                        <div class="alert alert-info mb-0">{{ 'To start to use this module, create your first cart amount slice with the form below.'|trans({}, domain) }}</div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">{{ 'Use only one slice'|trans({}, domain) }}</div>
                <div class="card-body">
                    <p class="text-muted">{{ 'In this mode, the customer loyalty account is credited for each constant purchase slice'|trans({}, domain) }}</p>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="loyalty_mode" id="loyalty_mode_unique" value="unique" {{ mode == 'unique' ? 'checked' }}>
                        <label class="form-check-label" for="loyalty_mode_unique">{{ 'Use this mode'|trans({}, domain) }}</label>
                    </div>

                    <div class="mb-3">
                        <label for="unique_slice_amount" class="form-label">{{ 'Slice amount'|trans({}, domain) }}</label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" class="form-control" name="unique_slice_amount" id="unique_slice_amount" value="{{ unique_slice_amount }}">
                            <span class="input-group-text">{{ currency_symbol }}</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="unique_slice_credit" class="form-label">{{ 'Amount credited for each slice'|trans({}, domain) }}</label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" class="form-control" name="unique_slice_credit" id="unique_slice_credit" value="{{ unique_slice_credit }}">
                            <span class="input-group-text">{{ currency_symbol }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, domain) }}</button>
    </div>
</form>

{# Delete forms live outside the update form (forms cannot be nested); their buttons are linked through the form attribute. #}
{% for slice in slices %}
    <form method="post" action="{{ path('loyalty_delete') }}" id="loyalty-delete-{{ slice.id }}" class="d-none">
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        <input type="hidden" name="slice_id" value="{{ slice.id }}">
    </form>
{% endfor %}

<div class="card mb-4">
    <div class="card-header">{{ 'Create a new slice'|trans({}, domain) }}</div>
    <div class="card-body">
        {{ form_start(create_form, {action: path('loyalty_create'), method: 'post', attr: {class: 'row g-2 align-items-end'}}) }}
            {% for field in ['min', 'max', 'amount'] %}
                <div class="col-md-3">
                    {{ form_label(attribute(create_form, field), null, {label_attr: {class: 'form-label'}}) }}
                    <div class="input-group">
                        {{ form_widget(attribute(create_form, field), {attr: {class: 'form-control'}}) }}
                        <span class="input-group-text">{{ currency_symbol }}</span>
                    </div>
                </div>
            {% endfor %}
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100">{{ 'Create this slice'|trans({}, domain) }}</button>
            </div>
        {{ form_end(create_form) }}
    </div>
</div>

<div class="card">
    <div class="card-header">{{ 'Current status of loyalty accounts'|trans({}, domain) }}</div>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>{{ 'Customer'|trans({}, domain) }}</th>
                    <th class="text-end">{{ 'Balance'|trans({}, domain) }}</th>
                </tr>
            </thead>
            <tbody>
            {% for account in accounts %}
                <tr>
                    <td><a href="{{ path('admin.customer.update.view', {customer_id: account.customer_id}) }}">{{ account.customer_name }}</a></td>
                    <td class="text-end">{{ format_money(account.amount) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center py-3">{{ 'No loyalty account exists yet.'|trans({}, domain) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
